# Environment variables OpenCode reads from this project.
#
# Copy to `.env.local` and fill in. `.env*` is already gitignored, so `.env.local`
# will not be committed. `.env.example` is committed and must never hold a real
# value.

# Landingfolio MCP server bearer token.
#
# Referenced from `.opencode/opencode.jsonc` as `{env:LANDINGFOLIO_API_KEY}`.
# Replace with the token from https://landingfolio.com settings.
LANDINGFOLIO_API_KEY=

# Site origin override. Read by SITE_ORIGIN in src/lib/site.ts, which is the
# single source for the layout's metadataBase, the sitemap URLs, and the
# robots.txt sitemap declaration.
#
# The production origin does NOT need this variable: SITE_ORIGIN falls back to
# https://lokeshrohilla.com, which is the live custom domain. That fallback is
# correct on Vercel, where this variable is not set.
#
# Set it locally so `npm run dev` emits localhost Open Graph URLs rather than
# claiming to be production. Delete it before deploying.
#
# Do not point this at VERCEL_PROJECT_PRODUCTION_URL. That is the deployment
# subdomain, and advertising it as canonical tells search engines the custom
# domain duplicates it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
