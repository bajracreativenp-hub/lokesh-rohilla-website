# Payload CMS Secret (used to sign JWTs and session tokens)
PAYLOAD_SECRET=your-secret-key-here-minimum-32-chars

# PostgreSQL Database URI (e.g. Supabase, Neon, Railway, Vercel Postgres)
# If left empty, Payload CMS automatically falls back to local SQLite (file:./payload.db)
# DATABASE_URI=postgresql://postgres:password@localhost:5432/lokesh_rohilla

# Optional SQLite database path override
# SQLITE_URL=file:./payload.db

# Vercel Blob Storage Token (Automatically provided by Vercel when adding Blob Store)
# When set in Vercel, media uploads persist directly into cloud storage
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
